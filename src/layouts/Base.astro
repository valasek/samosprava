---
import { languages, langs, ogLocale, t, type Lang } from '../i18n/ui';
import { slugs } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  // Path of the same page in each language, for the language switcher.
  alternates?: Partial<Record<Lang, string>>;
}

const { lang, title, alternates = {} } = Astro.props;
const pageTitle = title ? `${title} | ${t(lang, 'site.title')}` : t(lang, 'site.title');
const altLinks = langs.map((l) => ({ lang: l, href: alternates[l] ?? `/${l}/` }));
const nav = [
  { href: `/${lang}/`, label: t(lang, 'nav.home') },
  { href: `/${lang}/${slugs.candidates[lang]}/`, label: t(lang, 'nav.candidates') },
  { href: `/${lang}/${slugs.links[lang]}/`, label: t(lang, 'nav.links') },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={t(lang, 'site.description')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {altLinks.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site)} />)}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={t(lang, 'site.description')} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b5cad" />
    {import.meta.env.PROD && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "d6d6d30418fd4aa3b9a7f80f3ad75ff3"}'></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'nav.skip')}</a>
    <div class="banner" role="status">
      <span data-phase="before">{t(lang, 'banner.before')}</span>
      <span data-phase="during" hidden>{t(lang, 'banner.during')}</span>
      <span data-phase="after" hidden>
        {t(lang, 'banner.after')} <a href="https://volby.statistics.sk/" rel="noopener" target="_blank">volby.statistics.sk</a>
      </span>
    </div>
    <script is:inline>
      (() => {
        const now = Date.now();
        const phase =
          now >= Date.parse('2026-10-24T20:00:00+02:00') ? 'after' : now >= Date.parse('2026-10-24T07:00:00+02:00') ? 'during' : 'before';
        document.querySelectorAll('[data-phase]').forEach((el) => (el.hidden = el.dataset.phase !== phase));
      })();
    </script>
    <header class="site-header">
      <a class="brand" href={`/${lang}/`}>{t(lang, 'site.short')}</a>
      <nav class="lang-menu" aria-label={t(lang, 'lang.label')}>
        <details>
          <summary>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" />
            </svg>
            <span class="visually-hidden">{t(lang, 'lang.label')}:</span>
            <span>{languages[lang]}</span>
          </summary>
          <ul>
            {
              altLinks.map((a) => (
                <li>
                  <a href={a.href} hreflang={a.lang} lang={a.lang} aria-current={a.lang === lang ? 'true' : undefined}>
                    {languages[a.lang]}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </nav>
      <script is:inline>
        (() => {
          const menu = document.querySelector('.lang-menu details');
          const close = () => menu.removeAttribute('open');
          document.addEventListener('click', (e) => !menu.contains(e.target) && close());
          menu.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && menu.open) {
              close();
              menu.querySelector('summary').focus();
            }
          });
        })();
      </script>
    </header>
    <nav class="main-nav" aria-label={t(lang, 'site.title')}>
      {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
    </nav>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        {t(lang, 'footer.credit')}:{' '}
        <a href="https://stanislavvalasek.com" rel="author">Stanislav Valasek</a>{' · '}
        <a href={`/${lang}/${slugs.feedback[lang]}/`}>{t(lang, 'footer.feedback')}</a>{' · '}
        <a href="https://github.com/valasek/samosprava" rel="noopener" target="_blank">{t(lang, 'footer.source')}</a>
      </p>
      <p class="muted">{t(lang, 'footer.disclaimer')}</p>
    </footer>
  </body>
</html>
