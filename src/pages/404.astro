---
import Base from '../layouts/Base.astro';
import { languages, langs, t } from '../i18n/ui';
---

<Base lang="sk" title="Stránka sa nenašla / Page not found">
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="not-found-code" aria-hidden="true">404</p>
    <h1 id="not-found-title">{t('sk', 'notFound.title')} <span lang="en">{t('en', 'notFound.title')}</span></h1>

    <div class="not-found-languages">
      {
        langs.map((l) => (
          <section lang={l} aria-labelledby={`not-found-${l}`}>
            <h2 id={`not-found-${l}`}>{languages[l]}</h2>
            <p>{t(l, 'notFound.text')}</p>
            <a class="button" href={`/${l}/`}>{t(l, 'thanks.back')}</a>
          </section>
        ))
      }
    </div>
  </section>
</Base>