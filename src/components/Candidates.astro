---
import DistrictPicker from './DistrictPicker.astro';
import { t, type Lang } from '../i18n/ui';
import {
  bodyOrder,
  buildBallots,
  districtById,
  districts,
  envelope,
  fullName,
  initials,
  normalize,
  parties,
  streets,
  type Ballot,
  type Candidate,
} from '../lib/data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ballots = buildBallots();
const partyIndex = new Map(parties.map((p, i) => [p, String(i)]));
// Per district: streets [name, houses|null, okrsok], polling places, okrsok -> district-council obvod.
const streetData = Object.fromEntries(
  Object.entries(streets).map(([id, s]) => [
    id,
    {
      ...s,
      obvodByOkrsok: Object.fromEntries((districtById[id].mzObvody ?? []).flatMap((o) => o.okrsky.map((k) => [k, o.obvod]))),
    },
  ]),
);
const streetI18n = {
  okrsok: t(lang, 'street.okrsok'),
  obvod: t(lang, 'street.obvod'),
  houses: t(lang, 'street.houses'),
  whole: t(lang, 'street.whole'),
  pickHouse: t(lang, 'street.pickHouse'),
  notFound: t(lang, 'street.notFound'),
};

function title(b: Ballot): string {
  const name = t(lang, `body.${b.body}`);
  if (b.body === 'starosta' || b.body === 'mz') {
    const d = districtById[b.district!].name;
    return b.obvod ? `${name} ${d} – ${t(lang, 'ballot.obvod')} ${b.obvod}` : `${name} – ${d}`;
  }
  if (b.obvod) {
    const names = b.districts.map((id) => districtById[id].name).join(', ');
    return `${name} – ${t(lang, 'ballot.obvod')} ${b.obvod} (${names})`;
  }
  return name;
}

function hue(c: Candidate): number {
  let h = 2166136261;
  for (const ch of c.firstName + c.lastName) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
  return (h >>> 0) % 360;
}

const partyAttr = (c: Candidate) => (c.independent ? 'i' : c.parties.map((p) => partyIndex.get(p)).join(' '));
const searchAttr = (c: Candidate) => normalize(`${c.firstName} ${c.lastName} ${c.occupation} ${c.parties.join(' ')}`);
const moreHref = (c: Candidate) =>
  `https://www.google.com/search?q=${encodeURIComponent(`"${c.firstName} ${c.lastName}" Bratislava voľby 2026`)}`;
---

<form id="filters" class="filters card" role="search">
  <DistrictPicker lang={lang} />
  {
    Object.entries(streets).map(([id, s]) => (
      <fieldset class="street-lookup" data-streets-for={id} hidden>
        <legend>{t(lang, 'street.legend')}</legend>
        <label>
          {t(lang, 'filter.street')}
          <input name="ul" list={`dl-${id}`} autocomplete="off" />
          <datalist id={`dl-${id}`}>
            {[...new Set(s.streets.map((r) => r[0]))].sort((a, b) => a.localeCompare(b, 'sk')).map((n) => <option value={n} />)}
          </datalist>
        </label>
        <label>
          {t(lang, 'filter.house')}
          <input name="cd" inputmode="text" autocomplete="off" size="6" />
        </label>
        <div class="street-result" aria-live="polite" />
      </fieldset>
    ))
  }
  <label>
    {t(lang, 'filter.body')}
    <select name="v">
      <option value="">{t(lang, 'filter.allBodies')}</option>
      {bodyOrder.map((b) => <option value={b}>{t(lang, `body.${b}`)}</option>)}
    </select>
  </label>
  <label>
    {t(lang, 'filter.party')}
    <select name="p">
      <option value="">{t(lang, 'filter.allParties')}</option>
      <option value="i">{t(lang, 'filter.independent')}</option>
      {parties.map((p, i) => <option value={String(i)}>{p}</option>)}
    </select>
  </label>
  <label>
    <span class="visually-hidden">{t(lang, 'filter.search')}</span>
    <input type="search" name="q" placeholder={t(lang, 'filter.search')} autocomplete="off" />
  </label>
  <p class="filter-status">
    <span>{t(lang, 'filter.shown')}: <strong id="shown-count">{ballots.reduce((n, b) => n + b.candidates.length, 0)}</strong></span>
    <button type="reset" class="link-button">{t(lang, 'filter.reset')}</button>
  </p>
</form>

<button type="button" id="filter-pill" class="filter-pill" aria-controls="filters" hidden>
  <span class="filter-pill-text"><strong>{t(lang, 'filter.active')}:</strong> <span id="filter-pill-summary"></span></span>
  <span class="filter-pill-action">{t(lang, 'filter.edit')} ↑</span>
</button>

{
  districts
    .filter((d) => !d.mzObvody)
    .map((d) => (
      <p class="card note" data-note={d.id} hidden>
        {t(lang, 'cand.mzNote')} <a href={d.url} rel="noopener" target="_blank">{d.name}</a>
      </p>
    ))
}

<p id="no-results" class="card" hidden>{t(lang, 'filter.none')}</p>

{
  ballots.map((b) => (
    <section class={`ballot envelope-${envelope[b.body]}`} data-body={b.body} data-districts={b.districts.join(' ')} data-obvod={b.body === 'mz' ? b.obvod : undefined}>
      <h2>{title(b)}</h2>
      <p class="ballot-meta">
        <strong>{b.seats === 1 ? t(lang, 'ballot.circleOne') : `${t(lang, 'ballot.circleMax')} ${b.seats}`}</strong>
        <span>· {b.candidates.length} {t(lang, 'ballot.candidates')}</span>
        <span>· {t(lang, `ballot.envelope.${envelope[b.body]}`)}</span>
      </p>
      {b.okrsky && (
        <p class="muted small">
          {t(lang, 'ballot.okrsky')}: {b.okrsky.join(', ')}. {t(lang, 'cand.mzOkrsok')}
        </p>
      )}
      <ul class="cands">
        {b.candidates.map((c) => (
          <li class:list={['cand', { withdrawn: c.withdrawn }]} data-p={partyAttr(c)} data-q={searchAttr(c)}>
            {c.photo ? (
              <img class="avatar photo" src={c.photo.src} alt={fullName(c)} width="240" height="240" loading="lazy" />
            ) : (
              <span class="avatar" style={`--h:${hue(c)}`} aria-hidden="true">
                {initials(c)}
              </span>
            )}
            <div class="cand-body">
              <p class="cand-name">
                <span class="cand-num">{c.number}</span> {fullName(c)}
              </p>
              {c.withdrawn && <p class="badge-withdrawn">{t(lang, 'cand.withdrawn')}</p>}
              <p class="cand-meta">
                {c.age} {t(lang, 'cand.age')} · {c.occupation}
              </p>
              <p class="cand-party">{c.independent ? t(lang, 'cand.independent') : c.parties.join(', ')}</p>
              {c.residence && (
                <p class="cand-meta">
                  {t(lang, 'cand.residence')}: {c.residence}
                </p>
              )}
              <p class="cand-links small">
                {c.web && (
                  <a href={c.web} rel="noopener nofollow" target="_blank">
                    {t(lang, 'cand.web')} ↗
                  </a>
                )}
                <a href={moreHref(c)} rel="noopener nofollow" target="_blank">
                  {t(lang, 'cand.more')} ↗
                </a>
              </p>
              {c.photo && (
                <p class="photo-credit">
                  {t(lang, 'photo.credit')}: <a href={c.photo.source} rel="noopener" target="_blank">{c.photo.author}</a>,{' '}
                  {c.photo.permission ? (
                    t(lang, 'photo.permission')
                  ) : c.photo.licenseUrl ? (
                    <a href={c.photo.licenseUrl} rel="license noopener" target="_blank">{c.photo.license}</a>
                  ) : c.photo.license}, {t(lang, 'photo.cropped')}
                </p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<p class="muted small">{t(lang, 'cand.source')}</p>
<p class="muted small">{t(lang, 'photo.note')}</p>

<script type="application/json" id="streets-data" set:html={JSON.stringify(streetData)} />
<script type="application/json" id="streets-i18n" set:html={JSON.stringify(streetI18n)} />

<script>
  const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  const form = document.getElementById('filters') as HTMLFormElement;
  const groups = [...document.querySelectorAll<HTMLElement>('.ballot')].map((el) => ({
    el,
    body: el.dataset.body!,
    obvod: Number(el.dataset.obvod ?? 0),
    districts: el.dataset.districts!.split(' '),
    cards: [...el.querySelectorAll<HTMLElement>('.cand')].map((c) => ({
      el: c,
      parties: c.dataset.p!.split(' '),
      q: c.dataset.q!,
    })),
  }));
  const notes = [...document.querySelectorAll<HTMLElement>('[data-note]')];
  const countEl = document.getElementById('shown-count')!;
  const noResults = document.getElementById('no-results')!;
  const fields = ['mc', 'ul', 'cd', 'v', 'p', 'q'] as const;
  type StreetDistrict = {
    okrsky: Record<string, string>;
    streets: [string, string | null, number][];
    obvodByOkrsok: Record<string, number>;
  };
  const streetData: Record<string, StreetDistrict> = JSON.parse(document.getElementById('streets-data')!.textContent!);
  const si18n: Record<string, string> = JSON.parse(document.getElementById('streets-i18n')!.textContent!);
  const lookups = [...document.querySelectorAll<HTMLFieldSetElement>('[data-streets-for]')];

  function lookup(mc: string, ul: string, cd: string): { obvody: Set<number> | null; lines: string[] } {
    const d = streetData[mc];
    if (!d || !ul.trim()) return { obvody: null, lines: [] };
    const rows = d.streets.filter((r) => norm(r[0]) === norm(ul));
    if (!rows.length) return { obvody: null, lines: [si18n.notFound] };
    const house = cd.toUpperCase().replace(/\s/g, '');
    const byHouse = house ? rows.filter((r) => !r[1] || r[1].split(',').includes(house)) : rows;
    const match = byHouse.length ? byHouse : rows;
    const lines = match.map((r) => {
      const where = `${si18n.okrsok} ${r[2]} · ${si18n.obvod} ${d.obvodByOkrsok[r[2]]} – ${d.okrsky[r[2]]}`;
      return r[1] ? `${where} (${si18n.houses}: ${r[1].replaceAll(',', ', ')})` : `${where} (${si18n.whole})`;
    });
    if (new Set(match.map((r) => r[2])).size > 1) lines.unshift(si18n.pickHouse);
    return { obvody: new Set(match.map((r) => d.obvodByOkrsok[r[2]])), lines };
  }

  const pill = document.getElementById('filter-pill')!;
  const pillSummary = document.getElementById('filter-pill-summary')!;
  let filterOffscreen = false;
  let filterActive = false;

  function updatePill(shown: number) {
    const parts: string[] = [];
    for (const name of ['mc', 'v', 'p'] as const) {
      const sel = form.elements.namedItem(name) as HTMLSelectElement;
      if (sel.value) parts.push(sel.selectedOptions[0].text);
    }
    const f = new FormData(form);
    const ul = String(f.get('ul') ?? '').trim();
    const cd = String(f.get('cd') ?? '').trim();
    if (ul) parts.push(cd ? `${ul} ${cd}` : ul);
    const q = String(f.get('q') ?? '').trim();
    if (q) parts.push(`„${q}“`);
    filterActive = parts.length > 0;
    pillSummary.textContent = `${parts.join(' · ')} (${shown})`;
    pill.hidden = !(filterActive && filterOffscreen);
  }

  new IntersectionObserver(([e]) => {
    filterOffscreen = !e.isIntersecting && e.boundingClientRect.top < 0;
    pill.hidden = !(filterActive && filterOffscreen);
  }).observe(form);

  pill.addEventListener('click', () => {
    const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    form.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
    form.querySelector<HTMLElement>('select, input')?.focus({ preventScroll: true });
  });

  function apply() {
    const mcNow = (form.elements.namedItem('mc') as HTMLSelectElement).value;
    for (const fs of lookups) fs.hidden = fs.disabled = fs.dataset.streetsFor !== mcNow;
    const f = new FormData(form);
    const mc = String(f.get('mc') ?? '');
    const body = String(f.get('v') ?? '');
    const party = String(f.get('p') ?? '');
    const q = norm(String(f.get('q') ?? ''));
    const street = lookup(mc, String(f.get('ul') ?? ''), String(f.get('cd') ?? ''));
    for (const fs of lookups) {
      const out = fs.querySelector('.street-result')!;
      out.replaceChildren(
        ...(fs.disabled ? [] : street.lines).map((l) => Object.assign(document.createElement('p'), { textContent: l })),
      );
    }
    let shown = 0;
    for (const g of groups) {
      const groupOk =
        (!mc || g.districts.includes(mc)) &&
        (!body || g.body === body) &&
        !(street.obvody && g.body === 'mz' && !street.obvody.has(g.obvod));
      let n = 0;
      for (const c of g.cards) {
        const ok = groupOk && (!party || c.parties.includes(party)) && (!q || c.q.includes(q));
        c.el.hidden = !ok;
        if (ok) n++;
      }
      g.el.hidden = n === 0;
      shown += n;
    }
    for (const n of notes) n.hidden = !(mc && n.dataset.note === mc && (!body || body === 'mz'));
    countEl.textContent = String(shown);
    noResults.hidden = shown > 0;
    updatePill(shown);

    const params = new URLSearchParams();
    for (const k of fields) {
      const v = String(f.get(k) ?? '').trim();
      if (v) params.set(k, v);
    }
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    if (mc) localStorage.setItem('mc', mc);
  }

  const params = new URLSearchParams(location.search);
  if (!params.has('mc') && localStorage.getItem('mc')) params.set('mc', localStorage.getItem('mc')!);
  for (const k of fields) {
    const v = params.get(k);
    if (v) form.querySelectorAll<HTMLInputElement | HTMLSelectElement>(`[name="${k}"]`).forEach((el) => (el.value = v));
  }

  form.addEventListener('input', apply);
  form.addEventListener('submit', (e) => e.preventDefault());
  form.addEventListener('reset', () => {
    localStorage.removeItem('mc');
    setTimeout(apply);
  });
  apply();
</script>
